# ==========================================
# Instagram Scraper & AI Analyzer Configuration
# ==========================================

# --- Instagram Credentials / Session Cookie ---
# Método definitivo: Pega tu cabecera 'Cookie' completa de la pestaña Red del navegador para emular 100% tu navegador
INSTAGRAM_COOKIES=
INSTAGRAM_SESSION_ID=
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=

# --- Pipeline Settings ---
# Multiplicador sobre la mediana de reproducciones para considerar un Reel como Outlier/Viral
OUTLIER_MULTIPLIER=3.0
# Cantidad de posts recientes a extraer por cuenta objetivo
MAX_POSTS_PER_ACCOUNT=50
# Pausa en segundos entre solicitudes para evitar bloqueos
REQUEST_DELAY_SECONDS=3.0

# --- Whisper (STT) Settings ---
# Modelos disponibles: tiny, base, small, medium, large-v1, large-v2, large-v3
WHISPER_MODEL=large-v3
# Dispositivo: cuda (para NVIDIA GPU) o cpu
WHISPER_DEVICE=cuda
# Tipo de cómputo: float16 (recomendado en GPU), int8, float32 (para CPU)
WHISPER_COMPUTE_TYPE=float16

# --- LLM Provider Selection: gemini (vía API) o ollama (100% local y gratis) ---
LLM_PROVIDER=gemini

# --- Gemini API (LLM) Settings ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Ollama Local LLM Settings (Opcional, 100% local y sin costo de API) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --- Telegram Notifications (Optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Database & Storage Paths (Relative to project root) ---
DB_PATH=data/scrapper.db
AUDIO_DIR=data/audio
